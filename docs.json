{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Opinion Learn",
  "description": "Prediction markets, plainly explained — and how to read them around the 2026 FIFA World Cup.",
  "colors": {
    "primary": "#FF5917",
    "light": "#FF7A3D",
    "dark": "#FF5917"
  },
  "logo": {
    "light": "/logo/logo_color.svg",
    "dark": "/logo/logo_color.svg",
    "href": "https://app.opinion.trade"
  },
  "favicon": "/logo/symbolmark_color.svg",
  "appearance": {
    "default": "light"
  },
  "fonts": {
    "heading": {
      "family": "Manrope",
      "weight": 700
    },
    "body": {
      "family": "Manrope",
      "weight": 400
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Learn",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Prediction Market Basics",
            "pages": [
              "learn/what-is-a-prediction-market",
              "learn/prediction-markets-vs-sports-betting",
              "learn/trade-before-resolution",
              "learn/order-book-spread-liquidity"
            ]
          },
          {
            "group": "World Cup 2026",
            "pages": [
              "learn/world-cup-multi-choice-markets"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Open Opinion",
          "icon": "arrow-up-right-from-square",
          "href": "https://app.opinion.trade"
        },
        {
          "anchor": "World Cup Markets",
          "icon": "futbol",
          "href": "https://app.opinion.trade/world-cup"
        }
      ]
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Trade on Opinion",
      "href": "https://app.opinion.trade"
    }
  },
  "footer": {
    "socials": {
      "x": "https://x.com/opinionlabs",
      "github": "https://github.com/nicki-leee/Opinion-Blog"
    }
  }
}
